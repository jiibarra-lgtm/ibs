# Medición SEO/SEM — completar en Vercel (Settings → Environment Variables). ARCHIVO NUEVO.
# Sin estas variables no se carga ningún script de medición.
NEXT_PUBLIC_GTM_ID=          # Google Tag Manager, ej: GTM-XXXXXXX
NEXT_PUBLIC_GA4_ID=          # Google Analytics 4, ej: G-XXXXXXXXXX (si no usás GTM)
NEXT_PUBLIC_GADS_ID=         # Google Ads, ej: AW-XXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=   # Meta Pixel (opcional)
# Verificación de buscadores (alternativa a la verificación por DNS)
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
